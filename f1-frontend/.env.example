# ==============================================================================
# KERS F1 - Environment Configuration Template
# ==============================================================================
# IMPORTANT: Never commit actual API keys, credentials, or production secrets to
# version control. This template lists available environment variables.
# ==============================================================================

# Canonical URL of the deployed application (used for SEO, OpenGraph & Sitemaps)
NEXT_PUBLIC_SITE_URL=https://kers-f1.vercel.app

# Backend Telemetry API Base URL (FastAPI / OpenF1 Telemetry Engine)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional Privacy-Preserving Web Analytics (e.g., Google Analytics Measurement ID)
# Format: G-XXXXXXXXXX (Only active when the user grants consent in the Cookie Banner)
NEXT_PUBLIC_GA_ID=

# Environment Mode
NODE_ENV=production
