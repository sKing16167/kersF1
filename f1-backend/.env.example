# ============================================================
# COPY THIS FILE TO ".env" AND FILL IN REAL VALUES.
# Never commit the real .env file — it's already in .gitignore.
# ============================================================

# ---- App ----
APP_ENV=development                # development | staging | production
API_V1_PREFIX=/api/v1
SECRET_KEY=changeme-generate-a-long-random-string
CORS_ORIGINS=http://localhost:3000,https://kersf1.vercel.app

# ---- PostgreSQL (Star Schema: Drivers, Races, Laps, Constructors) ----
# If using Supabase: Project Settings -> Database -> Connection string (URI, "Session pooler" for Celery workers)
# If using local Docker: matches docker-compose.yml defaults below
POSTGRES_USER=f1user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=f1data
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://f1user:changeme@localhost:5432/f1data

# ---- Redis & Celery Monitoring ----
REDIS_URL=redis://localhost:6379/0
FLOWER_USER=admin
FLOWER_PASSWORD=generate-strong-flower-password-here

# ---- Object storage for telemetry (S3 or Cloudflare R2) ----
# S3:      leave STORAGE_ENDPOINT_URL blank, use real AWS keys/region
# R2:      set STORAGE_ENDPOINT_URL to https://<account_id>.r2.cloudflarestorage.com
STORAGE_PROVIDER=s3                # s3 | r2
STORAGE_BUCKET=f1-telemetry
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT_URL=
# Public/CDN base URL used to hand telemetry file links to the frontend (CloudFront, R2 public bucket, or signed URLs)
STORAGE_PUBLIC_BASE_URL=

# ---- OpenF1 (no key required, public API) ----
OPENF1_BASE_URL=https://api.openf1.org/v1

# ---- FastF1 cache (mandatory — avoids re-hitting the Ergast/F1 timing API) ----
FASTF1_CACHE_DIR=/data/fastf1_cache

# ---- Optional: Ergast replacement (Jolpica) if you outgrow FastF1's bundled Ergast mirror ----
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
